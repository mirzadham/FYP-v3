# Docker ignore file
# Excludes files not needed in production Docker images

# Virtual environments
venv/
.venv/
env/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment files (secrets injected at runtime)
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing
tests/
htmlcov/
.coverage
.pytest_cache/
test_*.txt
test_*.md

# Development artifacts
temp_build/
results/
*.ps1

# Documentation (not needed in runtime)
*.md
!README.md

# Source data files
data/handbook/pdf/
data/handbook/txt/

# Rasa cache
.rasa/

# Large files that should be built separately
# models/  # Uncomment if building models separately
