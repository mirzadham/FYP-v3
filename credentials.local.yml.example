# Local Development Credentials Configuration
# Copy this file to credentials.local.yml and configure for local setup

# Telegram channel configuration
telegram:
  access_token: "${TELEGRAM_BOT_TOKEN}"
  verify: "${TELEGRAM_BOT_USERNAME:-UPMAcademicAdvisorBot}"
  webhook_url: "https://your-unique-id.ngrok.io/webhooks/telegram/webhook"  # Replace 'your-unique-id' with actual ngrok subdomain

# REST channel for testing (always enabled for debugging)
rest:
