# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===================
# Required - Rasa Pro
# ===================
RASA_PRO_LICENSE=your_rasa_pro_license_here

# ===================
# Required - OpenAI
# ===================
OPENAI_API_KEY=your_openai_api_key_here

# ===================
# Required - Telegram
# ===================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===================
# Cloud Run Deployment
# ===================
# PostgreSQL connection string for Cloud SQL
# Format: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:your_password@/rasa_tracker?host=/cloudsql/your-project:asia-southeast1:rasa-db

# Action server URL (Cloud Run service URL)
ACTION_SERVER_URL=https://action-server-xxxxx-xx.a.run.app/webhook

# Rasa server webhook URL (for Telegram)
WEBHOOK_URL=https://rasa-server-xxxxx-xx.a.run.app
