# Environment Variables Template
# For local development: copy this file to .env and fill in the values below.
# For Railway deployment: configure these variables in the Railway Dashboard.

# ===================
# Required - Rasa Pro
# ===================
RASA_PRO_LICENSE=your_rasa_pro_license_here

# ===================
# Required - OpenAI
# ===================
OPENAI_API_KEY=your_openai_api_key_here

# ===================
# Required - Telegram
# ===================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=UPMAcademicAdvisorBot

# ===================
# Railway Deployment
# ===================
# PostgreSQL - Auto-provided by Railway when you add PostgreSQL service
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://...

# Action Server - Use Railway's internal networking
ACTION_SERVER_URL=http://action-server.railway.internal:8080/webhook

# Rasa Server URL - Railway provides this after generating domain
RASA_SERVER_URL=https://your-app.up.railway.app
