# Action Server Dockerfile
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y libpq5 curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY actions/ actions/

# PORT is injected by Cloud Run; default 8080 used for local development
EXPOSE 8080

# Use shell form to allow PORT variable substitution from Cloud Run
# Note: rasa is installed to /usr/local/bin by pip (without --user flag)
CMD exec rasa run actions -p ${PORT:-8080}
