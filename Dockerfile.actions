# Action Server Dockerfile for Railway
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y libpq5 curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY actions/ actions/

# Include handbook data for course lookups and semantic search
COPY data/handbook/json/ data/handbook/json/
COPY data/handbook/embeddings/ data/handbook/embeddings/

# Railway injects PORT automatically
EXPOSE 8080

# Health check for Railway
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD /bin/sh -c 'curl -f http://localhost:${PORT:-8080}/health || exit 1'

# Run action server
CMD exec rasa run actions -p ${PORT:-8080}
